# The TF-IDF /search endpoint needs no API key or database.

# OpenAI-compatible semantic retrieval and cited answer generation.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini
PROVIDER_TIMEOUT_SECONDS=30

# Optional PostgreSQL/pgvector production storage.
DATABASE_URL=
VECTOR_DIMENSIONS=1536

# Optional OpenTelemetry FastAPI tracing.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=rag-knowledge-assistant

LOG_LEVEL=INFO
